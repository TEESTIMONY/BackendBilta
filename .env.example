## Django REST backend settings
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=

## Database (SQLite default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

## Production security toggles
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
CSRF_TRUSTED_ORIGINS=

## Optional: auto-create Django admin user on startup (use in Render/production)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

## Optional: store uploaded media in a Supabase Storage bucket (S3 API)
USE_SUPABASE_STORAGE=false
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_ENDPOINT_URL=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
SUPABASE_MEDIA_LOCATION=media
SUPABASE_STORAGE_QUERYSTRING_AUTH=true
SUPABASE_STORAGE_URL_TTL_SECONDS=3600
SUPABASE_STORAGE_CACHE_CONTROL=max-age=86400

## CORS (local dev defaults; in production set CORS_ALLOW_ALL_ORIGINS=false and list the frontend origin)
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

## Login attempts allowed per username
DJANGO_LOGIN_THROTTLE_RATE=10/min
